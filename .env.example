# Copie este arquivo para ".env" e preencha os valores.
#
# Connection string do Neon (Postgres). Sem ela, o servidor local usa o
# arquivo .local-data.json como banco de teste.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Token simples de acesso (opcional). Se preenchido, o app pede o token
# uma vez e o guarda no navegador. No Vercel, defina APP_TOKEN como
# Environment Variable e use o MESMO valor aqui para testar local.
APP_TOKEN=
