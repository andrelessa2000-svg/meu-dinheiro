# Copie este arquivo para ".env" e preencha os valores.
#
# Connection string do Neon (Postgres). Sem ela, o servidor local usa o
# arquivo .local-data.json como banco de teste.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# No Vercel, defina apenas DATABASE_URL como Environment Variable.
# A autenticacao e por conta de usuario (login/senha) criada pelo proprio app,
# com sessoes guardadas no banco. Nao ha token compartilhado (APP_TOKEN).
